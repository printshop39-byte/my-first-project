# ====================================================================
# प्रिंटशुभ — Environment Variables Template
# ====================================================================
#
# Copy this file to .env.local (for local dev) or set these
# variables in your hosting provider's dashboard for production.
#
#   cp .env.example .env.local
#
# ⚠ Never commit .env or .env.local to git — they are in .gitignore.
# ====================================================================

# --- REQUIRED ---
# Your Anthropic API key. Used by api/ocr.js to call the Claude API.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# --- OPTIONAL ---
# Override the Anthropic model used for OCR (default in api/ocr.js).
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
