/* Tailwind base, components, utilities */
@tailwind base;
@tailwind components;
@tailwind utilities;

/* ----------------------------------------------------------------
   Global resets & html-level rules.
   The main design system, typography, fonts, and component
   styles live inside <GlobalStyle /> in src/App.jsx (~700 lines).
   We deliberately keep them there so the artifact stays portable
   and the dev experience is search-friendly.
---------------------------------------------------------------- */

html,
body,
#root {
  height: 100%;
}

body {
  margin: 0;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

/* Smooth scrolling for in-page anchors (e.g. "Scroll to Tool") */
html {
  scroll-behavior: smooth;
}

/* Marathi text rendering tweaks */
:lang(mr) {
  font-feature-settings: "kern" 1, "liga" 1;
}
